<Window x:Class="DesktopPet.CaptureRegionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#66000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
        MouseMove="Overlay_MouseMove"
        MouseLeftButtonUp="Overlay_MouseLeftButtonUp"
        MouseRightButtonDown="Overlay_MouseRightButtonDown"
        KeyDown="Overlay_KeyDown">
    <Canvas>
        <Rectangle x:Name="SelectionRectangle"
                   Stroke="White" StrokeThickness="2"
                   Fill="#33FFFFFF"
                   Visibility="Collapsed"/>
    </Canvas>
</Window>
